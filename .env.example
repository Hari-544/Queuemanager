# QueueManager backend configuration - copy to server/.env or ./.env and edit.
# NEVER commit a real .env file. All values below are placeholders/defaults.

# Port for the backend (serves the app + JSON API on one origin).
PORT=8080
# Bind address. Keep 127.0.0.1 for local demos; use 0.0.0.0 behind a trusted
# reverse proxy or container network.
HOST=127.0.0.1
# development | production
NODE_ENV=development

# SQLite database file. Created automatically (including folders).
DB_PATH=./data/queueease.db

# Secret for signing session cookies. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The built-in default works for local demo only and prints a warning.
SESSION_SECRET=change-me-to-a-long-random-string
# Set true when served over HTTPS. Automatically true in production mode.
COOKIE_SECURE=false

# Session lifetime in hours.
SESSION_TTL_HOURS=12
# Seed fictional records on an empty database for demonstrations. Set false
# for a clean operational deployment.
SEED_DEMO_DATA=true

# Seeded demo accounts (created once, on first boot with an empty database).
# Change these for anything beyond a local demo.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin-demo-123
SEED_STAFF_USER=staff
SEED_STAFF_PASSWORD=staff-demo-123

# Rate limits (requests per minute per client).
RATE_BOOK_PER_MIN=20
RATE_LOGIN_PER_MIN=10
RATE_GENERAL_PER_MIN=300

# Max JSON body size in bytes.
BODY_LIMIT_BYTES=102400
